{
  "name": "tepic-options-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "test": "node --test tests/cores/*.test.ts tests/cycles/cycle-simulator.test.ts tests/market/*.test.ts tests/database/*.test.ts tests/trading/*.test.ts tests/research/*.test.ts",
    "test:trading": "node --test tests/trading/*.test.ts tests/market/*.test.ts",
    "test:db": "node --test tests/database/*.test.ts",
    "test:browser": "node scripts/verify-browser.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node scripts/database-schema.mjs",
    "db:mongo:setup": "node --env-file=.env.mongo.local services/mongo-api/setup.ts",
    "db:mongo:serve": "node --env-file=.env.mongo.local services/mongo-api/server.ts",
    "trading:serve": "node --env-file=.env.trading.local services/trading-runner/server.ts",
    "broker:check": "node scripts/verify-alpaca-connection.mjs",
    "research:check": "node scripts/verify-research-connection.mjs",
    "verify:clean": "node scripts/verify-clean-install.mjs",
    "fred:check": "node scripts/verify-fred-connection.mjs",
    "db:check": "node scripts/verify-database-connection.mjs",
    "db:check:supabase": "node scripts/verify-selected-database.mjs supabase",
    "db:check:mongo": "node scripts/verify-selected-database.mjs mongodb"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/server": "^1.9.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mongodb": "7.9.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
