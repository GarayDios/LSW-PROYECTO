# Copia este archivo a .env.local para el terminal. Deja todo vacío para usar modo local.
# Solo servidor. No usar prefijos NEXT_PUBLIC_ ni VITE_ en estas variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa para proyectos que aún usan la clave JWT service_role:
SUPABASE_SERVICE_ROLE_KEY=

# Servicio Mongo independiente; HTTPS en producción. Opcional hasta tener Atlas.
MONGO_BRIDGE_URL=
MONGO_BRIDGE_TOKEN=

# Para services/mongo-api, usa otro archivo ignorado: .env.mongo.local.
# En ese archivo configura MONGO_BRIDGE_TOKEN con el mismo valor del terminal.
MONGODB_URI=
MONGODB_DATABASE=tepic_terminal
MONGO_BRIDGE_HOST=127.0.0.1
MONGO_BRIDGE_PORT=8788

# Alpaca: solo datos y cuenta Paper. Los hosts están fijados en el código.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
# ID de la identidad autenticada que puede usar esta cuenta compartida.
# GET /api/broker/status muestra tu propio ID; local Sites usa local_seedy.
BROKER_OWNER_USER_ID=

# Servicio de ejecución continua, separado de la pestaña del navegador.
TRADING_RUNNER_URL=
TRADING_RUNNER_TOKEN=
ALPACA_AUTOMATION_ENABLED=false
# Copia las claves de Alpaca, el propietario, el token y estos valores a .env.trading.local.
TRADING_RUNNER_DB=.sites-runtime/trading-runner.sqlite
TRADING_RUNNER_HOST=127.0.0.1
TRADING_RUNNER_PORT=8790
TRADING_MAX_ORDER_USD=1000
TRADING_MAX_DAILY_LOSS_USD=
TRADING_MAX_TOTAL_EXPOSURE_USD=
# Opcional: receptor HTTPS propio de alertas JSON. Dejar vacío no envía mensajes.
TRADING_ALERT_WEBHOOK_URL=
TRADING_ALERT_WEBHOOK_TOKEN=

# Investigación: solo servidor. Los campos vacíos se muestran como no configurados.
# indicative es una fuente derivada de OPRA; opra requiere la suscripción correspondiente.
ALPACA_OPTIONS_FEED=indicative
# Identifica tu proyecto y un correo de contacto real para acceso justo a SEC EDGAR.
SEC_USER_AGENT=
FRED_API_KEY=
