# Copia este archivo a .env.local para el terminal. Deja todo vacío para usar modo local.
# Solo servidor. No usar prefijos NEXT_PUBLIC_ ni VITE_ en estas variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Alternativa para proyectos que aún usan la clave JWT service_role:
SUPABASE_SERVICE_ROLE_KEY=

# Servicio Mongo independiente; HTTPS en producción. Opcional hasta tener Atlas.
MONGO_BRIDGE_URL=http://127.0.0.1:8788
MONGO_BRIDGE_TOKEN=

# Para services/mongo-api, usa otro archivo ignorado: .env.mongo.local.
# En ese archivo configura MONGO_BRIDGE_TOKEN con el mismo valor del terminal.
# Configuración privada del servicio MongoDB. No compartir este archivo.
MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/
MONGO_BRIDGE_TOKEN=
MONGODB_DATABASE=tepic_terminal
MONGO_BRIDGE_HOST=127.0.0.1
MONGO_BRIDGE_PORT=8788


# Alpaca: solo datos y cuenta Paper. Los hosts están fijados en el código.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
# ID de la identidad autenticada que puede usar esta cuenta compartida.
# GET /api/broker/status muestra tu propio ID; local Sites usa local_seedy.
BROKER_OWNER_USER_ID=local_seedy

# Servicio de ejecución continua, separado de la pestaña del navegador.
TRADING_RUNNER_URL=
TRADING_RUNNER_TOKEN=
ALPACA_AUTOMATION_ENABLED=false
# Copia las claves de Alpaca, el propietario, el token y estos valores a .env.trading.local.
TRADING_RUNNER_DB=.sites-runtime/trading-runner.sqlite
TRADING_RUNNER_HOST=127.0.0.1
TRADING_RUNNER_PORT=8790
TRADING_MAX_ORDER_USD=1000
TRADING_MAX_DAILY_LOSS_USD=
TRADING_MAX_TOTAL_EXPOSURE_USD=
# Opcional: receptor HTTPS propio de alertas JSON. Dejar vacío no envía mensajes.
TRADING_ALERT_WEBHOOK_URL=
TRADING_ALERT_WEBHOOK_TOKEN=

# Investigación: solo servidor. Los campos vacíos se muestran como no configurados.
# indicative es una fuente derivada de OPRA; opra requiere la suscripción correspondiente.
ALPACA_OPTIONS_FEED=indicative
# Identifica tu proyecto y un correo de contacto real para acceso justo a SEC EDGAR.
SEC_USER_AGENT=TEPIC Options Lab contacto@tu-dominio.example
FRED_API_KEY=
# Complemento empresarial automático: Basic Financials, Profile 2 y recomendaciones.
# Crear una clave gratuita en https://finnhub.io/register. Solo servidor.
FINNHUB_API_KEY=

# Opciones manuales Alpaca Paper: incluir en .env.local y .env.trading.local.
# La habilitacion del servidor no envia ordenes: cada una requiere confirmacion.
ALPACA_F5_ENABLED=false
ALPACA_F5_AUTOMATION_ENABLED=false
TRADING_F5_DB=.sites-runtime/trading-f5.sqlite

# Webull OpenAPI: credenciales de PRUEBAS en .env.trading.local, nunca en el navegador.
# US sandbox: saldos, posiciones, ordenes, velas y opciones; permisos segun cuenta.
# Diagnostico de lectura: npm run broker:check:webull -- --data --symbol=NVDA
# Solicita primero acceso OpenAPI y verifica region y entorno con Webull.
# us para el portal webull.com; mx para webull.com.mx. No se deduce por residencia.
WEBULL_REGION=mx
WEBULL_ENVIRONMENT=sandbox
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
# Usa account_id de Account List, no el número visible de la cuenta.
# Este flag debe estar en .env.local y .env.trading.local.
WEBULL_MANUAL_ENABLED=false
TRADING_WEBULL_DB=.sites-runtime/trading-webull.sqlite
# Opcional: vacío usa un archivo F5 separado y vinculado a la cuenta Webull.
TRADING_WEBULL_F5_DB=
