# ID de la identidad autenticada que puede usar esta cuenta compartida.
# GET /api/broker/status muestra tu propio ID; local Sites usa local_seedy.
BROKER_OWNER_USER_ID=local_seedy

# Servicio de ejecución continua, separado de la pestaña del navegador.
TRADING_RUNNER_URL=
TRADING_RUNNER_TOKEN=
ALPACA_AUTOMATION_ENABLED=false
# Copia las claves de Alpaca, el propietario, el token y estos valores a .env.trading.local.
TRADING_RUNNER_DB=.sites-runtime/trading-runner.sqlite
TRADING_RUNNER_HOST=127.0.0.1
TRADING_RUNNER_PORT=8790
TRADING_MAX_ORDER_USD=1000
TRADING_MAX_DAILY_LOSS_USD=
TRADING_MAX_TOTAL_EXPOSURE_USD=
# Opcional: receptor HTTPS propio de alertas JSON. Dejar vacío no envía mensajes.
TRADING_ALERT_WEBHOOK_URL=
TRADING_ALERT_WEBHOOK_TOKEN=

# Investigación: solo servidor. Los campos vacíos se muestran como no configurados.
# indicative es una fuente derivada de OPRA; opra requiere la suscripción correspondiente.
ALPACA_OPTIONS_FEED=indicative
